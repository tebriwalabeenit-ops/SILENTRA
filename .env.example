# ==============================================================================
# SILENTRA — System Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME=SILENTRA
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=silentra_development_secret_key_change_in_production_min32chars

# Operational Mode
# Options:
#   - HYBRID: Real hardware on assigned pins; simulation on unmonitored entities
#   - HARDWARE_ONLY: Exclusively live physical ESP32 sensors (no simulator)
#   - SIMULATION_ONLY: Fully synthetic generation for testing / demo sandbox
APP_MODE=HYBRID

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=silentra_user
POSTGRES_PASSWORD=silentra_password
POSTGRES_DB=silentra_db
DATABASE_URL=postgresql+asyncpg://silentra_user:silentra_password@localhost:5432/silentra_db

# SQLite Fallback (for zero-install quick local development)
SQLITE_DB_URL=sqlite+aiosqlite:///./silentra_dev.db
USE_SQLITE_FALLBACK=true

# MQTT Broker (Mosquitto)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=silentra_backend_srv
MQTT_USERNAME=silentra_mqtt
MQTT_PASSWORD=silentra_mqtt_secret
MQTT_KEEPALIVE=60
MQTT_TOPIC_PREFIX=silentra

# Library Hardware Settings (Prototype Defaults)
PROTOTYPE_DEVICE_ID=ESP32-DEV-PROTOTYPE-01
NOISE_THRESHOLD_DB_SPL=65.0
NOISE_WARNING_DURATION_SEC=5
INACTIVITY_TIMEOUT_MINUTES=30

# Frontend Variables
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws
VITE_APP_NAME=SILENTRA
